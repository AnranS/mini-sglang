---
// Top-of-page meta for a stage: position in the route, time budget,
// prerequisites, and the progress control shared with the home page roadmap.
import StageStatus from './react/StageStatus';
import { STAGE_BY_ID, STAGES } from '../data/stages.mjs';
import { pageUrl } from '../lib/urls';

interface Props {
	id: string;
}

const stage = STAGE_BY_ID[Astro.props.id];
if (!stage) throw new Error(`[StageHeader] 未知阶段：${Astro.props.id}`);
const prereqs = stage.prereq.map((id: string) => STAGE_BY_ID[id]);
---
<div class="stage-header not-content">
	<div class="stage-meta">
		<span class="stage-chip">阶段 {stage.n} / {STAGES.length - 1}</span>
		<span class="stage-chip">预计 {stage.time}</span>
		{
			prereqs.length > 0 && (
				<span class="stage-prereq">
					前置：
					{prereqs.map((p: (typeof STAGES)[number], i: number) => (
						<>
							{i > 0 && '、'}
							<a href={pageUrl(p.slug)}>
								{p.n} · {p.title}
							</a>
						</>
					))}
				</span>
			)
		}
	</div>
	<StageStatus client:load id={stage.id} />
</div>
